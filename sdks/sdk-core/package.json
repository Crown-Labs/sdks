{
  "name": "@kittycorn-labs/sdk-core",
  "version": "2.0.1",
  "description": "⚒️ An SDK for building applications on top of Uniswap V3",
  "repository": "https://github.com/Crown-Labs/sdks.git",
  "keywords": [
    "uniswap",
    "ethereum"
  ],
  "license": "MIT",
  "main": "./dist/cjs/src/index.js",
  "typings": "./dist/types/src/index.d.ts",
  "module": "./dist/esm/src/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/esm/src/index.js",
      "require": "./dist/cjs/src/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.spec.ts"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "bun run clean && tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && tsc -p tsconfig.types.json && node ../../scripts/fix-esm.js",
    "clean": "rm -rf dist",
    "test": "bun test src"
  },
  "dependencies": {
    "@ethersproject/address": "^5.0.2",
    "@ethersproject/bignumber": "^5.5.0",
    "@ethersproject/bytes": "^5.7.0",
    "@ethersproject/keccak256": "5.7.0",
    "@ethersproject/strings": "5.7.0",
    "big.js": "^5.2.2",
    "decimal.js-light": "^2.5.0",
    "jsbi": "^3.1.4",
    "tiny-invariant": "^1.1.0",
    "toformat": "^2.0.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@types/big.js": "^4.0.5"
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "singleQuote": true
  },
  "publishConfig": {
    "access": "public"
  }
}

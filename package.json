{
  "name": "sdks",
  "version": "0.0.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.10",
  "private": true,
  "trustedDependencies": [],
  "scripts": {
    "g:build": "node scripts/build.js",
    "g:test": "bun test sdks/sdk-core/src sdks/v2-sdk/src sdks/v3-sdk/src sdks/v4-sdk/src sdks/router-sdk/src sdks/universal-router-sdk/src sdks/universal-router-sdk/test/unit sdks/universal-router-sdk/test/utils",
    "g:pack": "node scripts/pack.js",
    "g:release": "node scripts/pack.js --publish",
    "g:version": "node scripts/version.js",
    "g:abis": "node scripts/abis.js",
    "g:audit": "bun audit"
  },
  "workspaces": [
    "sdks/sdk-core",
    "sdks/v2-sdk",
    "sdks/v3-sdk",
    "sdks/v4-sdk",
    "sdks/router-sdk",
    "sdks/universal-router-sdk"
  ],
  "devDependencies": {
    "typescript": "4.9.5",
    "prettier": "2.8.8"
  },
  "overrides": {
    "ws": "8.21.0"
  }
}
